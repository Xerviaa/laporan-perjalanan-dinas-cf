{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "monica-imut",
	"compatibility_date": "2026-10-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://vjmcxvxmupprsuvwgvgtd.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_9v_YQop-DYuooK4eFwc92A_8w_Vetan"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "monica-imut"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "laporan-files"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "f78066d43943419299ac78a80c3cd7a6",
			"localConnectionString": "postgres://unused:unused@127.0.0.1:5432/unused"
		}
	],
	// PERBAIKAN: Menghapus "issue_detection" yang tidak valid
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false
		}
	}
}